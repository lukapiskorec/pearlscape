dist/
build/
*.tsbuildinfo

# Pearlscape exports
RhinoPython/exports/

# Local PLY exports stay out of git, but any .ply you commit under web/data/
# ships with the web explorer. List it in web/data/models.json to surface it
# in the dropdown.
web/data/*
!web/data/models.json
!web/data/palettes.json
!web/data/*.ply

